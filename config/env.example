# .env in the install directory — created by bin/initialize.py; these lines are added by the installer and the Setup pages.
# Never commit the real file.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.10.9
OPENCLAW_TZ=America/New_York
PROCURATOR_EDITION=standard
PROCURATOR_OWNER_ID=              # the owner's Telegram user id, set when the owner is paired
PROCURATOR_PUBLIC_BASE=https://box.example.com
# ANTHROPIC_API_KEY=... (set with bin/set-api-key.sh; never pasted into chat)
